# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must never be committed.

# Financial Modeling Prep API key — get one at
# https://site.financialmodelingprep.com/developer/docs
# The app reads this from the environment (app/providers/fmp.py).
FMP_API_KEY=your-key-here

# Supabase-backed production auth/quota/metering.
# Set both in Vercel server-side environment variables. Never expose the
# service-role key to browser JavaScript.
# When both are present, valuation endpoints require X-API-Key and use
# Supabase for per-key daily quotas and usage records.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but recommended before issuing production keys. When set, newly
# created or rotated API keys are stored as peppered HMAC-SHA256 hashes.
# Keep this stable and secret; changing it invalidates peppered keys.
API_KEY_HASH_PEPPER=replace-with-a-long-random-secret

# Public base URL of THIS deployment (no trailing slash). Used to build the
# GitHub OAuth redirect (`{PUBLIC_BASE_URL}/v1/auth/callback`) and the
# post-login/error redirect back to the site. Must exactly match a URL in
# Supabase's Authentication > URL Configuration > Redirect URLs allowlist.
# Defaults to http://127.0.0.1:8000 for local development.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional Phase 8 distributed cache/coordination. Vercel Marketplace usually
# injects these automatically when Upstash is connected. Older integrations
# may use KV_REST_API_URL and KV_REST_API_TOKEN instead; both names are read.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ADR-010 valuation response cache. 0 = OFF (the default): every request
# recomputes against a live Finnhub price, exactly as ADR-008 specified. Any
# positive value caches whole responses for that many seconds and is the FULL
# staleness bound on the price a caller may be served -- so a repeat identical
# request is answered without a provider call. Needs Redis above. Start at 30
# or 60 if you enable it, and read ADR-010 first: a non-zero value also lets
# the caller's browser answer repeats without reaching the API, which means
# those repeats are not metered.
VALUATION_CACHE_TTL_SECONDS=0
